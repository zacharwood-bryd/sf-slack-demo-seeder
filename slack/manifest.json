{
  "_metadata": {
    "major_version": 2,
    "minor_version": 1
  },
  "display_information": {
    "name": "Demo Publisher",
    "description": "Publishes Salesforce demo updates into Slack. People do not message this app.",
    "background_color": "#0f5f5b"
  },
  "features": {
    "bot_user": {
      "display_name": "Demo Publisher",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "channels:join",
        "channels:manage",
        "channels:read",
        "chat:write",
        "chat:write.public",
        "groups:read",
        "groups:write",
        "usergroups:read",
        "usergroups:write"
      ]
    }
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
